pico-8 cartridge // http://www.pico-8.com
version 32
__lua__
-- memory/psram stress test
-- focus on random memory access
-- heavy sprite rendering

count = 100

function _init()
end

function _update()
 if (btn(0)) count -= 50
 if (btn(1)) count += 50
 if (count < 0) count = 0
end

function _draw()
 cls(0)
 -- draw random sprites from random locations
 -- this forces cache misses if gfx data is in psram
 for i=1,count do
  -- random sprite index (0-63)
  local s = flr(rnd(64))
  -- random screen position
  local x = rnd(120)
  local y = rnd(120)
  spr(s, x, y)
 end
 
 rectfill(0,0,128,20,0)
 print("ram/bus stress test", 30, 2, 7)
 print("sprites: "..count, 40, 10, 7)
end

